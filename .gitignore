# Large data files — use root-level /vol/.../data/ instead
data/raw/
data/processed/
data/interim/
data/cache/
data/external/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Environment
.env
.venv

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Large binary outputs — use root-level /vol/.../outputs/ instead
*.pt
*.pth
*.ckpt
*.bin
*.h5
*.hdf5

# Keep tracked data subdirectories
!data/splits/
!data/metadata/

# 报告 LaTeX 源码与编译产物不随公开仓库分发；仓库内只保留成稿 report.pdf
report/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

