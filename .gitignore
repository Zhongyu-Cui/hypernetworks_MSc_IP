# Large data files — use root-level /vol/.../data/ instead
data/raw/
data/processed/
data/interim/
data/cache/
data/external/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Environment
.env
.venv

# OS / IDE
.DS_Store
.vscode/
.idea/
*.swp

# Large binary outputs — use root-level /vol/.../outputs/ instead
*.pt
*.pth
*.ckpt
*.bin
*.h5
*.hdf5

# Keep tracked data subdirectories
!data/splits/
!data/metadata/
